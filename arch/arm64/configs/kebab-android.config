# SPDX-License-Identifier: GPL-2.0
#
# OnePlus 8T (kebab) Mainline Linux Android Configuration Fragment
#

# SELinux
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y

# Binder (C implementation, Rust is off); binderfs creates these devices on mount
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Android userspace loads plain .ko files
CONFIG_LOCALVERSION="-mainline"

# Filesystems & Storage for Android Dynamic Partitions
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_UNICODE=y
CONFIG_EROFS_FS=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_FUSE_FS=y
CONFIG_INCREMENTAL_FS=y

# Android memfd ashmem shim & USB configfs uevents
CONFIG_MEMFD_ASHMEM_SHIM=y
CONFIG_ANDROID_USB_CONFIGFS_UEVENT=y

# First-stage init mounts the adb remount overlay, before any module can load
CONFIG_OVERLAY_FS=y

# Modem AT ports (DATA1/DATA4) for the radio HAL
CONFIG_WWAN=y
CONFIG_RPMSG_WWAN_CTRL=m

# Security, KeyMint, TEE, Biometrics
CONFIG_QCOMTEE=y
CONFIG_FINGERPRINT_GOODIX_FP=m
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_QCOM_QSEECOM=y
CONFIG_QCOM_QSEECOM_BRIDGE=y

# Built-in ALSA sound card for OnePlus 8T
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_PINCTRL_SM8250_LPASS_LPI=y
CONFIG_SND_SOC_TFA987X=y
CONFIG_SND_SOC_SM8250=y
CONFIG_SND_SOC_QCOM_COMMON=y
CONFIG_SND_SOC_QCOM_SDW=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SOC_USB=y
CONFIG_SND_SOC_QDSP6_USB=y

# Persistent RAM / Ramoops / pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_COMPRESS=y
CONFIG_GNSS=y
CONFIG_MHI_WWAN_CTRL=y
CONFIG_MHI_NET=y
CONFIG_MHI_BUS_SAHARA_MDM=y

# Built-in drivers expected by Android userspace (no vendor .ko modules)
CONFIG_HW_RANDOM=y
CONFIG_CRYPTO_DEV_QCOM_RNG=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_NFC=y
CONFIG_NFC_NCI=y
CONFIG_NFC_NXP_NCI=y
CONFIG_NFC_NXP_NCI_I2C=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZ4=y
CONFIG_UHID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_SONY=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_APPLE=y
CONFIG_HID_STEAM=y
CONFIG_HID_WACOM=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_WIREGUARD=y
CONFIG_LEDS_CLASS_MULTICOLOR=y

# Kernel and bootloader diagnostics
CONFIG_QCOM_UEFI_KBOOTLOG=y
CONFIG_QCOM_KLOG_FLUSH=y


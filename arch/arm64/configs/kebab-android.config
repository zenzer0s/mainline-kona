# SPDX-License-Identifier: GPL-2.0
#
# OnePlus 8T (kebab) SM8250 GKI Fragment
#
# Usage:
#   make ARCH=arm64 LLVM=1 gki_defconfig kebab-android.config
#
# Note: gki_defconfig enables CONFIG_RUST=y (for ACK's Rust ashmem).
# For local builds without a Rust/bindgen toolchain, append:
#   ../me-cafebabe-aosp-mainline/android_kernel_mainline_configs/fragments/n/disable-rust.config
#

CONFIG_LOCALVERSION="-mainline"
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_CMA_SIZE_MBYTES=64

# SM8250 Core Clocks & Pinctrl
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SM_GCC_8250=y
CONFIG_SM_DISPCC_8250=y
CONFIG_SM_GPUCC_8250=y
CONFIG_SM_VIDEOCC_8250=y
CONFIG_SM_CAMCC_8250=y
CONFIG_CLK_GFM_LPASS_SM8250=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM8250=y
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_PINCTRL_SM8250_LPASS_LPI=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y

# Interconnect, SPMI, PMICs & Regulators
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_MFD_QCOM_PM8008=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_REGULATOR_QCOM_PM8008=y
CONFIG_REGULATOR_QCOM_REFGEN=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y

# SoC Infrastructure, IPC, IOMMU, CPUfreq, Thermal, Watchdog, RTC
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_OPLUS_SENSOR_DEVINFO=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_ICC_BWMON=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_RESET_QCOM_AOSS=y
CONFIG_RESET_QCOM_PDC=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_WATCHDOG_PRETIMEOUT_GOV=y
CONFIG_WATCHDOG_PRETIMEOUT_GOV_PANIC=y
CONFIG_WATCHDOG_PRETIMEOUT_DEFAULT_GOV_PANIC=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RTC_DRV_PM8XXX=y

# Serial, I2C, SPI & DMA (GENI / BAM)
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_I2C_QCOM_CCI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_QCOM_BAM_DMA=y

# Storage, USB, Type-C, PCIe & PHYs
CONFIG_SCSI_UFS_QCOM=y
CONFIG_CHR_DEV_SG=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_TYPEC_MUX_FSA4480=y
CONFIG_PCIE_QCOM=y

# Display, GPU, Panel & Video
CONFIG_VT=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_SAMSUNG_AMB655X=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_VIDEO_QCOM_VENUS=y

# Input, Touchscreen, Haptics, Battery, LEDs & NFC
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_TOUCHSCREEN_SYNAPTICS_S3908=y
CONFIG_INPUT_AW8695_HAPTICS=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_CHARGER_MP2650=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_LEDS_QCOM_FLASH=y
CONFIG_RFKILL=y
CONFIG_NFC=y
CONFIG_NFC_NQ_NCI=y
CONFIG_ZRAM=y

# Audio (QDSP6, SoundWire, LPASS Macros, WCD938x, TFA987x)
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_QCOM_APR=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QCOM_COMMON=y
CONFIG_SND_SOC_QCOM_SDW=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_QDSP6_USB=y
CONFIG_SND_SOC_USB=y
CONFIG_SND_SOC_SM8250=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SND_SOC_LPASS_WSA_MACRO=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WCD938X_SDW=y
CONFIG_SND_SOC_TFA987X=y

# Remoteprocs, FastRPC, QRTR, Wi-Fi (QCA6390/ath11k), SDX55 MHI & GNSS
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_FASTRPC=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_MHI=y
CONFIG_QRTR_TUN=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_WWAN=y
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_PCI_GENERIC=y
CONFIG_MHI_BUS_SAHARA_MDM=y
CONFIG_MHI_WWAN_CTRL=y
CONFIG_MHI_NET=y
CONFIG_NET_VENDOR_QUALCOMM=y
CONFIG_RMNET=y
CONFIG_QCOM_IPA=y
CONFIG_GNSS=y

# Security, TEE, QSEECOM, Fingerprint, DMA-BUF Heaps & RNG
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_HW_RANDOM=y
CONFIG_CRYPTO_DEV_QCOM_RNG=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
CONFIG_QCOM_QSEECOM=y
CONFIG_QCOM_QSEECOM_UEFISECAPP=y
CONFIG_QCOM_QSEECOM_BRIDGE=y
CONFIG_TEE=y
CONFIG_QCOMTEE=y
CONFIG_FINGERPRINT_GOODIX_FP=y

# Persistent RAM / Ramoops / pstore & Boot Diagnostics
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_COMPRESS=y
CONFIG_QCOM_UEFI_KBOOTLOG=y
CONFIG_QCOM_KLOG_FLUSH=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
